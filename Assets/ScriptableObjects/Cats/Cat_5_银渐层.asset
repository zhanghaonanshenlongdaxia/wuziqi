  m_Name: "Cat_5_\u94F6\u6E10\u5C42"
  m_EditorClassIdentifier: 
  catName: "\u963F\u94F6"
  description: "\u94F6\u6E10\u5C42\u540D\u53EB\u963F\u94F6\uFF0C\u51FA\u8EAB\u4ED9\u55B5\u6751\u7684\u540D\u95E8\u671B\u65CF\uFF0C\u4ECE\u5C0F\u63A5\u53D7\u6700\u597D\u7684\u68CB\u9053\u6559\u80B2\u3002\u4ED6\u7684\u6BDB\u8272\u4ECE\u94F6\u767D\u6E10\u53D8\u5230\u6DF1\u7070\uFF0C\u4F18\u96C5\u5F97\u50CF\u4E00\u5E45\u5DE5\u7B14\u753B\u3002\u963F\u94F6\u4E0B\u68CB\u4ECE\u4E0D\u6025\u8E81\uFF0C\u6BCF\u4E00\u6B65\u90FD\u8981\u6DF1\u601D\u719F\u8651\uFF0C\u636E\u8BF4\u4ED6\u6700\u957F\u7684\u4E00\u6B65\u68CB\u60F3\u4E86\u6574\u6574\u4E00\u70B7\u9999\u7684\u65F6\u95F4\u3002\u4ED6\u7684\u68CB\u98CE\u539A\u5B9E\u7A33\u5065\uFF0C\u50CF\u4E00\u5EA7\u79FB\u52A8\u7684\u57CE\u5899\uFF0C\u5BF9\u624B\u5F80\u5F80\u5728\u4E0D\u77E5\u4E0D\u89C9\u4E2D\u5C31\u88AB\u4ED6\u56F4\u5F97\u6C34\u6CC4\u4E0D\u901A\u3002\u867D\u7136\u51FA\u8EAB\u9AD8\u8D35\uFF0C\u4F46\u963F\u94F6\u4ECE\u4E0D\u6446\u67B6\u5B50\uFF0C\u7ECF\u5E38\u5728\u68CB\u9662\u91CC\u6307\u70B9\u540E\u8F88\u3002\u4ED6\u8BF4\uFF1A\u771F\u6B63\u7684\u8D35\u65CF\uFF0C\u4E0D\u5728\u4E8E\u8840\u7EDF\uFF0C\u800C\u5728\u4E8E\u68CB\u54C1\u3002"
  portrait: {fileID: 21300000, guid: 18211769fc12dec4d8c0b99bff1455b8, type: 3}
