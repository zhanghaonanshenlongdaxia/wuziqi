  greetings: "\u4F18\u96C5\u5730\u5750\u4E0B\u5427\uFF0C\u8FD9\u76D8\u68CB\u4F1A\u5F88\u7F8E\u3002|\u94F6\u8272\u6708\u5149\u4E0B\uFF0C\u6700\u9002\u5408\u5BF9\u5F08\u4E86\u3002|\u6211\u7684\u68CB\u98CE\u5982\u94F6\u4E1D\u822C\u7EC6\u817B\uFF0C\u5C0F\u5FC3\u54E6\u3002"
