  m_Script: {fileID: 11500000, guid: 079b26729f079c945b0c5941c396997b, type: 3}
  m_Name: "Cat_6_\u7384\u732B"
  m_EditorClassIdentifier: 
  catName: "\u58A8\u9690"
  description: "\u7384\u732B\u662F\u4ED9\u55B5\u6751\u6700\u795E\u79D8\u7684\u68CB\u624B\uFF0C\u901A\u4F53\u7EAF\u9ED1\uFF0C\u636E\u8BF4\u5728\u6708\u5706\u4E4B\u591C\u4F1A\u9690\u8EAB\u4E8E\u591C\u8272\u4E2D\u3002\u6CA1\u4EBA\u77E5\u9053\u4ED6\u4ECE\u54EA\u91CC\u6765\uFF0C\u53EA\u77E5\u9053\u67D0\u5929\u4ED6\u7A81\u7136\u51FA\u73B0\u5728\u6751\u91CC\u7684\u68CB\u9662\uFF0C\u8FDE\u80DC\u5341\u4E09\u4F4D\u9AD8\u624B\u540E\u98D8\u7136\u79BB\u53BB\u3002\u4ED6\u7684\u68CB\u98CE\u6781\u5176\u51F6\u731B\uFF0C\u64C5\u957F\u5728\u770B\u4F3C\u5E73\u6DE1\u7684\u5C40\u9762\u4E2D\u57CB\u4E0B\u9677\u9631\uFF0C\u7B49\u5BF9\u624B\u53D1\u73B0\u65F6\u5DF2\u7ECF\u6EE1\u76D8\u7686\u8F93\u3002\u6751\u91CC\u7684\u8001\u4EBA\u4EEC\u8BF4\uFF0C\u7384\u732B\u53EF\u80FD\u662F\u767E\u5E74\u524D\u5931\u8E2A\u7684\u6697\u5F71\u68CB\u5723\u7684\u4F20\u4EBA\u3002\u6BCF\u5F53\u591C\u6DF1\u4EBA\u9759\u65F6\uFF0C\u6709\u732B\u770B\u5230\u4ED6\u5728\u5C4B\u9876\u4E0A\u72EC\u81EA\u6446\u68CB\uFF0C\u6708\u5149\u6D12\u5728\u68CB\u76D8\u4E0A\uFF0C\u9ED1\u767D\u68CB\u5B50\u4EFF\u4F5B\u5728\u547C\u5438\u3002"
  portrait: {fileID: 21300000, guid: 5b6cd349d06efa44b90cfd28ff4269f8, type: 3}
  difficulty: 4
  aiSearchDepth: 6
  aiScoreMultiplier: 2.2
  winReward: 120
  challengeCost: 18
  unlockType: 2
  coinCost: 200
  framesDir: 玄猫
  greetings: "\u2026\u2026\u4F60\u786E\u5B9A\u8981\u548C\u6211\u5BF9\u5F08\uFF1F|\u7384\u732B\u7684\u68CB\u5C40\uFF0C\u4ECE\u6765\u6CA1\u6709\u4EBA\u770B\u900F\u8FC7\u3002|\u591C\u5DF2\u6DF1\uFF0C\u68CB\u6B63\u6D53\uFF0C\u843D\u5B50\u5427\u3002"
