using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.UI;
using TMPro;
using Wuziqi.Core;
using Wuziqi.Game;

namespace Wuziqi.UI
{
    /// <summary>
    /// 鐚粰浜哄鎵嬶細杩愯鏃跺抚鍔ㄧ敾锛堢洿鎺ユ崲Sprite锛夈€佸璇濇皵娉°€佸眬鍔挎儏缁仈鍔ㄣ€佽繛鑳滆褰曘€?    /// 涓嶄緷璧?Animator / UnityEditor API锛屾墦鍖呭畨鍏ㄣ€?    /// </summary>
    public class CharacterController : MonoBehaviour
    {
        public enum Mood { Idle, Thinking, Smug, Worried, Celebrate, Defeat }

        [Header("寮曠敤")]
        [SerializeField] private GameManager gameManager;
        [SerializeField] private Image portrait;
        [SerializeField] private GameObject bubbleRoot;
        [SerializeField] private TMP_Text bubbleText;
        [SerializeField] private TMP_Text streakText;
        [SerializeField] private Sprite fallbackPortrait;

        [Header("鍔ㄧ敾")]
        [SerializeField, Range(2f, 15f)] private float frameRate = 6f;
        [SerializeField] private string framesResourcePath = "CatFrames";

        [Header("鍙拌瘝搴?)]
        [SerializeField, TextArea] private string[] openingLines = { "鍝硷紝鏈粰鐚浣犱笁瀛愩€?, "鏉ユ潵鏉ワ紝鏈骇鍊掕鐪嬬湅浣犵殑妫嬪姏銆? };
        [SerializeField, TextArea] private string[] openingLinesStreak3 = { "杩炶儨涓夊満锛屽熬宸磋缈樹笂澶╀簡锛? };
        [SerializeField, TextArea] private string[] openingLinesStreak5 = { "鍙堟槸浣狅紵锛佽繖娆℃湰浠欑尗缁濅笉鐣欐儏锛? };
        [SerializeField, TextArea] private string[] thinkingLines = { "璁╂垜鎯虫兂鈥?, "鍞斺€﹁繖姝ユ鏈夌巹鏈衡€? };
        [SerializeField, TextArea] private string[] aiStrongLines = { "鎺ユ嫑锛?, "鐪嬪ソ浜嗭紝杩欏氨鏄粰瀹剁殑瀹炲姏锝? };
        [SerializeField, TextArea] private string[] aiGoodLines = { "鍢垮樋锛屽涓嶅彲瑷€锝?, "鏈骇鐨勬锛屽ぉ琛ｆ棤缂濄€? };
        [SerializeField, TextArea] private string[] playerThreatBigLines = { "涓嶃€佷笉濡欌€?, "杩欎笉鍙兘锛? };
        [SerializeField, TextArea] private string[] playerThreatLines = { "鍜︼紵鏈変袱涓嬪瓙銆?, "灏忕灖浣犱簡鈥? };
        [SerializeField, TextArea] private string[] aiWinLines = { "鎵胯鎵胯锝炲柕", "鏈粰鐚疂鍒€鏈€侊紒" };
        [SerializeField, TextArea] private string[] playerWinLines = { "鍝硷紒浠婃棩鐘舵€佷笉浣筹紝涓嶇畻涓嶇畻銆?, "鏈骇鈥﹀彧鏄鐫€浣狅紒" };
        [SerializeField, TextArea] private string[] drawLines = { "骞冲眬锛熸湁瓒ｏ紝浣犳湁浜涢暱杩涖€? };

        // 甯у姩鐢绘暟鎹?        private Dictionary<Mood, Sprite[]> moodFrames = new Dictionary<Mood, Sprite[]>();
        private Mood currentMood = Mood.Idle;
        private Mood pendingMood;
        private bool hasPending;
        private float moodHoldUntil;
        private Coroutine animRoutine;
        private Coroutine bubbleRoutine;
        private float lastBubbleEnd = -10f;
        private const float BubbleCooldown = 2.5f;

        private void Start()
        {
            if (gameManager == null) gameManager = GameManager.Instance;
            gameManager.StonePlaced += OnStonePlaced;
            gameManager.PlayerTurnChanged += OnTurnChanged;
            gameManager.BoardReset += OnBoardReset;
            gameManager.GameEnded += OnGameEnded;

            if (bubbleRoot != null) bubbleRoot.SetActive(false);
            UpdateStreakText();

            if (portrait != null)
                portrait.preserveAspect = true;

            // 鍔犺浇榛樿甯у姩鐢?            LoadFrames("idle", Mood.Idle);
            LoadFrames("thinking", Mood.Thinking);
            LoadFrames("smug", Mood.Smug);
            LoadFrames("worried", Mood.Worried);
            LoadFrames("celebrate", Mood.Celebrate);
            LoadFrames("defeat", Mood.Defeat);

            SetMood(Mood.Idle);
            ShowBubble(PickLine(OpeningLinesForStreak(WinStreak.Get())), 3f, true);

            if (CatManager.Instance != null)
                CatManager.Instance.OnCatChanged += OnCatChanged;
        }

        private void OnDestroy()
        {
            if (gameManager != null)
            {
                gameManager.StonePlaced -= OnStonePlaced;
                gameManager.PlayerTurnChanged -= OnTurnChanged;
                gameManager.BoardReset -= OnBoardReset;
                gameManager.GameEnded -= OnGameEnded;
            }
            if (CatManager.Instance != null)
                CatManager.Instance.OnCatChanged -= OnCatChanged;
        }

        // ---------- 甯у姞杞?----------

        private void LoadFrames(string moodName, Mood mood)
        {
            // 灏濊瘯鍔犺浇褰撳墠鐚殑甯э紝澶辫触鍒欏洖閫€鍒伴粯璁ゅ抚
            string path = framesResourcePath + "/" + moodName;
            var sprites = Resources.LoadAll<Sprite>(path);
            if (sprites == null || sprites.Length == 0)
            {
                // 鍥為€€锛氫笉甯﹀瓙鐩綍
                sprites = Resources.LoadAll<Sprite>(moodName);
            }

            if (sprites != null && sprites.Length > 0)
            {
                // 鎸夊悕绉版帓搴忕‘淇濋『搴忔纭?                var list = new List<Sprite>(sprites);
                list.Sort((a, b) => a.name.CompareTo(b.name));
                moodFrames[mood] = list.ToArray();
            }
        }

        private void OnCatChanged(int newIndex)
        {
            var cat = CatManager.Instance.GetCat(newIndex);
            if (cat != null)
            {
                // 閲嶆柊鍔犺浇璇ョ尗鐨勫抚锛堝鏋滄湁涓撳睘甯х洰褰曪級
                LoadFrames("idle", Mood.Idle);
                LoadFrames("thinking", Mood.Thinking);
                LoadFrames("smug", Mood.Smug);
                LoadFrames("worried", Mood.Worried);
                LoadFrames("celebrate", Mood.Celebrate);
                LoadFrames("defeat", Mood.Defeat);

                if (portrait != null && cat.portrait != null)
                    portrait.sprite = cat.portrait;
            }
            SetMood(Mood.Idle);
        }

        // ---------- 甯у姩鐢绘挱鏀?----------

        private void SetMood(Mood mood, float hold = 0f)
        {
            currentMood = mood;

            // 鍋滄鏃у姩鐢?            if (animRoutine != null)
                StopCoroutine(animRoutine);

            // 鎾斁鏂板姩鐢?            if (moodFrames.TryGetValue(mood, out var frames) && frames.Length > 0)
                animRoutine = StartCoroutine(PlayFrameAnimation(frames));
            else if (portrait != null && fallbackPortrait != null)
                portrait.sprite = fallbackPortrait;

            if (hold > 0f) moodHoldUntil = Time.time + hold;
        }

        private IEnumerator PlayFrameAnimation(Sprite[] frames)
        {
            float interval = 1f / frameRate;
            int index = 0;
            while (true)
            {
                if (portrait != null)
                    portrait.sprite = frames[index];
                index = (index + 1) % frames.Length;
                yield return new WaitForSeconds(interval);
            }
        }

        private void TrySetMood(Mood mood)
        {
            if (Time.time < moodHoldUntil)
            {
                pendingMood = mood;
                hasPending = true;
                return;
            }
            SetMood(mood);
        }

        // ---------- 鍥炶皟 ----------

        private void OnStonePlaced(Vector2Int cell, StoneColor color)
        {
            if (color == gameManager.playerColor)
            {
                long threat = GomokuAI.EvaluateThreat(gameManager.Board, cell.x, cell.y, color);
                if (threat >= GomokuAI.FourScore)
                {
                    TrySetMood(Mood.Worried);
                    ShowBubble(PickLine(playerThreatBigLines), 3f);
                }
                else if (threat >= GomokuAI.OpenThreeScore)
                {
                    TrySetMood(Mood.Thinking);
                    ShowBubble(PickLine(playerThreatLines), 3f);
                }
            }
            else
            {
                long threat = GomokuAI.EvaluateThreat(gameManager.Board, cell.x, cell.y, color);
                if (threat >= GomokuAI.FourScore)
                {
                    TrySetMood(Mood.Smug);
                    ShowBubble(PickLine(aiStrongLines), 3f);
                }
                else
                {
                    TrySetMood(Mood.Thinking);
                    ShowBubble(PickLine(aiGoodLines), 3f);
                }
            }
        }

        private void OnTurnChanged(bool isPlayerTurn)
        {
            if (isPlayerTurn)
                TrySetMood(Mood.Idle);
            else
            {
                TrySetMood(Mood.Thinking);
                ShowBubble(PickLine(thinkingLines), 3f, true);
            }
        }

        private void OnBoardReset()
        {
            SetMood(Mood.Idle);
            ShowBubble(PickLine(OpeningLinesForStreak(WinStreak.Get())), 3f, true);
        }

        private void OnGameEnded(GameResult result, IReadOnlyList<Vector2Int> line)
        {
            bool playerWon = (result == GameResult.BlackWin && gameManager.playerColor == StoneColor.Black)
                          || (result == GameResult.WhiteWin && gameManager.playerColor == StoneColor.White);
            bool aiWon = (result == GameResult.BlackWin && gameManager.playerColor == StoneColor.White)
                      || (result == GameResult.WhiteWin && gameManager.playerColor == StoneColor.Black);

            if (playerWon)
            {
                SetMood(Mood.Defeat);
                ShowBubble(PickLine(playerWinLines), 3.5f, true);
                WinStreak.Add();
            }
            else if (aiWon)
            {
                SetMood(Mood.Celebrate);
                ShowBubble(PickLine(aiWinLines), 3.5f, true);
                WinStreak.Reset();
            }
            else
            {
                SetMood(Mood.Worried);
                ShowBubble(PickLine(drawLines), 3f, true);
            }
            UpdateStreakText();
        }

        private void Update()
        {
            if (hasPending && Time.time >= moodHoldUntil)
            {
                SetMood(pendingMood);
                hasPending = false;
            }

            // 淇濇寔 Image 鏄剧ず褰撳墠甯?            if (portrait != null && portrait.sprite == null && fallbackPortrait != null)
                portrait.sprite = fallbackPortrait;
        }

        // ---------- 姘旀场 ----------

        public void ShowBubble(string text, float duration = 2.5f, bool force = false)
        {
            if (string.IsNullOrEmpty(text)) return;
            if (!force && Time.time < lastBubbleEnd + BubbleCooldown) return;
            if (bubbleRoutine != null) StopCoroutine(bubbleRoutine);
            bubbleRoutine = StartCoroutine(BubbleRoutine(text, duration));
        }

        private IEnumerator BubbleRoutine(string text, float duration)
        {
            if (bubbleText != null) bubbleText.text = text;
            if (bubbleRoot != null) bubbleRoot.SetActive(true);
            lastBubbleEnd = Time.time + duration;
            yield return new WaitForSeconds(duration);
            if (bubbleRoot != null) bubbleRoot.SetActive(false);
            lastBubbleEnd = Time.time;
        }

        // ---------- 宸ュ叿 ----------

        private static string PickLine(string[] lines)
        {
            if (lines == null || lines.Length == 0) return null;
            return lines[Random.Range(0, lines.Length)];
        }

        private string[] OpeningLinesForStreak(int streak)
        {
            if (streak >= 5) return openingLinesStreak5;
            if (streak >= 3) return openingLinesStreak3;
            return openingLines;
        }

        private void UpdateStreakText()
        {
            if (streakText == null) return;
            int streak = WinStreak.Get();
            streakText.gameObject.SetActive(streak > 0);
            streakText.text = $"杩炶儨 脳{streak}";
        }

        /// <summary>杩炶儨璁板綍锛圥layerPrefs 鎸佷箙鍖栵級銆?/summary>
        public static class WinStreak
        {
            private const string Key = "Wuziqi.WinStreak";

            public static int Get() => PlayerPrefs.GetInt(Key, 0);

            public static int Add()
            {
                int v = Get() + 1;
                PlayerPrefs.SetInt(Key, v);
                PlayerPrefs.Save();
                return v;
            }

            public static void Reset()
            {
                PlayerPrefs.SetInt(Key, 0);
                PlayerPrefs.Save();
            }
        }
    }
}

